# Security headers for the hosted app (Cloudflare Pages reads this file; other hosts ignore it).
# connect-src allows the team API on any https host and localhost for local integration; tighten it
# to the real API host once there is one.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:*; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), microphone=(self)
  Strict-Transport-Security: max-age=31536000

/config.js
  Cache-Control: no-store
