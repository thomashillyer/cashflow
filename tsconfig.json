{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["schema", "db", "adapters", "engine", "ai", "api", "intake", "fixtures/**/*.ts", "**/*.test.ts"],
  "exclude": ["node_modules", "dist"]
}
