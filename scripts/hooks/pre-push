#!/bin/sh
# Block any push that updates or deletes refs/heads/main. Branch + PR instead (see CLAUDE.md).
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch (p<person>/<topic>) and open a PR." >&2
    exit 1
  fi
done
exit 0
