# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> API in the dashboard, or `npx supabase status` for local dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Hosted runtime: private accounts only. Local fixture demo: NERI_STORE=memory DEMO_MODE=1.
NODE_ENV=production
NERI_STORE=supabase
DEMO_MODE=0
NERI_AI_MODE=live

# Server-managed connectors are bound to ONE private business; never a sample.
NERI_CONNECTOR_BUSINESS_ID=
# Existing Outlook application credentials (read-only email import).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX_UPN=
# Optional Zoho Books connection; domain must match a supported Zoho region.
ZOHO_API_DOMAIN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
