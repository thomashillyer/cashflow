# Copy to .env and fill in. Never commit .env.
# Supabase: Project Settings -> API in the dashboard, or `npx supabase status` for local dev.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Connect (api/sourceAccess.ts): the server's own app credentials, usable only by the verified email below until the
# per-owner Connect flow (#128). Never commit real values.
NERI_SOURCE_EMAIL=
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAILBOX_UPN=

# Local connector probes (scripts/*-connect.ts, scripts/probe-*.ts).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENV=sandbox
